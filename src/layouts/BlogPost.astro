---
export interface Props {
  title: string;
  description?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  heroImage?: string;
  category?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category = "Football Culture",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

const formatDate = (value?: Date | string) => {
  if (!value) return "";
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return String(value);

  return new Intl.DateTimeFormat("en-IN", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? title} />
    <title>{title} — KITCLUB Journal</title>
  </head>

  <body>
    <main class="article-page">
      <header class="article-header">
        <div class="article-container">
          <a href={`${baseUrl}journal/`} class="article-back">Back to Journal</a>

          <div class="article-category">{category}</div>

          <h1>{title}</h1>

          {description && <p class="article-dek">{description}</p>}

          {(pubDate || updatedDate) && (
            <div class="article-meta">
              {pubDate && <span>{formatDate(pubDate)}</span>}
              {updatedDate && (
                <>
                  <span class="meta-separator">·</span>
                  <span>Updated {formatDate(updatedDate)}</span>
                </>
              )}
            </div>
          )}
        </div>

        {heroImage && (
          <div class="article-hero">
            <img src={heroImage} alt={title} />
          </div>
        )}
      </header>

      <div class="article-container article-content">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #ffffff;
  }

  :global(body) {
    margin: 0;
    background: #ffffff;
    color: #111111;
    font-family: Arial, Helvetica, sans-serif;
  }

  .article-page {
    min-height: 100vh;
  }

  .article-header {
    padding: 72px 24px 0;
  }

  .article-container {
    width: min(920px, 100%);
    margin: 0 auto;
  }

  .article-back {
    display: inline-block;
    margin-bottom: 64px;
    color: #022f23;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .article-back:hover {
    text-decoration: underline;
  }

  .article-category {
    margin-bottom: 18px;
    color: #022f23;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
  }

  .article-dek {
    max-width: 760px;
    margin: 28px 0 0;
    color: #626262;
    font-size: 21px;
    line-height: 1.5;
  }

  .article-meta {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    color: #777777;
    font-size: 14px;
  }

  .meta-separator {
    color: #aaaaaa;
  }

  .article-hero {
    width: min(1180px, 100%);
    margin: 64px auto 0;
  }

  .article-hero img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 680px;
    object-fit: cover;
  }

  .article-content {
    padding: 72px 24px 120px;
    font-size: 18px;
    line-height: 1.8;
  }

  .article-content :global(p) {
    margin: 0 0 28px;
  }

  .article-content :global(h2) {
    margin: 56px 0 20px;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .article-content :global(h3) {
    margin: 44px 0 16px;
    font-size: 25px;
    line-height: 1.2;
  }

  .article-content :global(strong) {
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .article-header {
      padding: 40px 20px 0;
    }

    .article-back {
      margin-bottom: 42px;
    }

    h1 {
      font-size: clamp(38px, 12vw, 58px);
    }

    .article-dek {
      font-size: 18px;
    }

    .article-hero {
      margin-top: 44px;
    }

    .article-content {
      padding: 52px 20px 80px;
      font-size: 17px;
    }
  }
</style>

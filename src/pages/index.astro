---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="The KITCLUB Journal — football shirts, football culture, kit history and stories from the world of the beautiful game."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.kitclub.in/journal/" />
    <title>KITCLUB Journal — Football Shirts & Culture</title>
  </head>

  <body>
    <div class="announcement-bar">
      <small>Free Shipping above ₹1500</small>
    </div>

    <header class="site-header">
      <nav class="site-navbar" aria-label="Main navigation">
        <div class="site-header-inner">
          <a class="site-logo" href="https://www.kitclub.in/" aria-label="KITCLUB home">
            <img
              src="https://www.kitclub.in/web/image/website/1/logo/KITCLUB?unique=7938d2f"
              alt="KITCLUB"
            />
          </a>

          <ul class="site-nav" role="menubar">
            <li>
              <a href="https://www.kitclub.in/shop">Shop All</a>
            </li>
            <li>
              <a href="https://www.kitclub.in/contactus">Contact Us</a>
            </li>
          </ul>

          <div class="header-actions">
            <a
              class="header-action"
              href="https://www.kitclub.in/shop/cart"
              aria-label="Shopping cart"
            >
              <i class="fa fa-shopping-cart" aria-hidden="true"></i>
            </a>

            <button
              class="header-action search-trigger"
              type="button"
              aria-label="Search KITCLUB"
              aria-controls="site-search-modal"
              aria-expanded="false"
            >
              <i class="fa fa-search" aria-hidden="true"></i>
            </button>

            <a
              class="social-link"
              href="https://chat.whatsapp.com/F7knZUObUaGFBvZosMC4Cu"
              aria-label="KITCLUB WhatsApp group"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa fa-whatsapp" aria-hidden="true"></i>
            </a>

            <a
              class="social-link"
              href="https://www.instagram.com/kitclub.in/"
              aria-label="KITCLUB Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa fa-instagram" aria-hidden="true"></i>
            </a>

            <button
              class="mobile-menu-trigger"
              type="button"
              aria-label="Open menu"
              aria-controls="mobile-menu"
              aria-expanded="false"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>

            <div class="account-wrap">
              <a
                class="account-sign-in"
                href="https://www.kitclub.in/web/login?redirect=/journal/"
              >
                Sign in
              </a>

              <button
                class="account-link account-menu-trigger"
                type="button"
                aria-label="KITCLUB account menu"
                aria-haspopup="true"
                aria-expanded="false"
              >
                KITCLUB
                <span class="account-chevron" aria-hidden="true"></span>
              </button>

              <div class="account-menu" role="menu">
                <a href="https://www.kitclub.in/my/home" role="menuitem">
                  <i class="fa fa-id-card-o" aria-hidden="true"></i>
                  My Account
                </a>
                <a href="https://www.kitclub.in/web/session/logout?redirect=/" role="menuitem">
                  <i class="fa fa-sign-out" aria-hidden="true"></i>
                  Logout
                </a>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <div class="mobile-menu-backdrop" data-mobile-menu-close></div>
      <aside class="mobile-menu-drawer" aria-label="Mobile navigation">
        <div class="mobile-menu-top">
          <button class="mobile-menu-close" type="button" aria-label="Close menu" data-mobile-menu-close>
            <i class="fa fa-times" aria-hidden="true"></i>
          </button>
          <div class="mobile-menu-search">
            <input id="mobile-menu-search-input" type="search" placeholder="Search..." aria-label="Search KITCLUB" />
            <button type="button" aria-label="Search" id="mobile-menu-search-button">
              <i class="fa fa-search" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <nav class="mobile-menu-links" aria-label="Mobile navigation links">
          <a href="https://www.kitclub.in/shop">Shop All</a>
          <a href="https://www.kitclub.in/contactus">Contact Us</a>
        </nav>

        <div class="mobile-menu-socials">
          <a href="https://chat.whatsapp.com/F7knZUObUaGFBvZosMC4Cu" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <i class="fa fa-whatsapp" aria-hidden="true"></i>
          </a>
          <a href="https://www.instagram.com/kitclub.in/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <i class="fa fa-instagram" aria-hidden="true"></i>
          </a>
        </div>

        <a class="mobile-menu-signin" href="https://www.kitclub.in/web/login?redirect=/journal/">Sign in</a>
      </aside>
    </div>

    <div class="search-modal" id="site-search-modal" aria-hidden="true">
      <div class="search-modal-backdrop" data-search-close></div>
      <div class="search-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="search-modal-label">
        <div class="search-box-row">
          <label id="search-modal-label" class="visually-hidden" for="site-search-input">Search KITCLUB</label>
          <input
            id="site-search-input"
            type="search"
            name="search"
            autocomplete="off"
            placeholder=""
            aria-label="Search KITCLUB"
          />
          <button class="search-modal-close" type="button" aria-label="Close search" data-search-close>
            <i class="fa fa-times" aria-hidden="true"></i>
          </button>
          <a class="search-result-count" href="https://www.kitclub.in/website/search/all" aria-label="View all search results">
            <span class="search-count-number"></span>
            <span>result(s)</span>
          </a>
        </div>
        <div class="search-results-wrap">
          <div class="search-status" aria-live="polite"></div>
          <div class="search-results" aria-live="polite"></div>
        </div>
      </div>
    </div>

    <main>
      <section class="journal-hero">
        <div class="journal-hero-inner">
          <p class="journal-eyebrow">KITCLUB JOURNAL</p>
          <h1>Football shirts. Stories. Culture.</h1>
          <p class="journal-intro">
            A closer look at the kits, players, clubs and moments that make football
            more than just a game.
          </p>
        </div>
      </section>

      <section class="articles-section">
        <div class="articles-inner">
          <div class="section-heading">
            <h2>Latest from the Journal</h2>
          </div>

          {posts.length > 0 ? (
            <div class="article-grid">
              {posts.map((post) => (
                <article class="article-card">
                  <a
                    class="article-card-link"
                    href={`${import.meta.env.BASE_URL}journal/${post.id}/`}
                  >
                    {post.data.heroImage && (
                      <div class="article-image-wrap">
                        <Image
                          class="article-image"
                          src={post.data.heroImage}
                          alt={post.data.title}
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="article-content">
                      <p class="article-date">
                        {post.data.pubDate.toLocaleDateString("en-IN", {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        })}
                      </p>
                      <h3>{post.data.title}</h3>
                      <p class="article-description">{post.data.description}</p>
                      <span class="read-more">Read article →</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <p>No articles yet.</p>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-column">
          <h3>Shop</h3>
          <a href="https://www.kitclub.in/shop">All Jerseys</a>
          <a href="https://www.kitclub.in/shop">New Season</a>
          <a href="https://www.kitclub.in/shop">Player Version</a>
          <a href="https://www.kitclub.in/shop">Master Version</a>
        </div>

        <div class="footer-column">
          <h3>Support</h3>
          <a href="https://www.kitclub.in/contactus">Contact Us</a>
          <a href="https://www.kitclub.in/shipping-policy">Shipping Policy</a>
          <a href="https://www.kitclub.in/returns-exchanges">Returns &amp; Exchanges</a>
          <a href="https://www.kitclub.in/">Cancellations &amp; Refunds</a>
          <a href="https://www.kitclub.in/">Dispatch Guarantee</a>
          <a href="https://www.kitclub.in/">FAQ</a>
        </div>

        <div class="footer-column">
          <h3>Legal</h3>
          <a href="https://www.kitclub.in/">Privacy Policy</a>
          <a href="https://www.kitclub.in/">Terms &amp; Conditions</a>
          <p class="footer-note">*Free Shipping above ₹1500</p>

          <div class="footer-payments" aria-label="Accepted payment methods">
            <img src="https://cdn.simpleicons.org/americanexpress/1677F2" alt="American Express" />
            <img src="https://cdn.simpleicons.org/visa/1434CB" alt="Visa" />
            <img src="https://cdn.simpleicons.org/mastercard" alt="Mastercard" />
            <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/RuPay.svg" alt="RuPay" />
            <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/UPI_logo.svg" alt="UPI" />
          </div>
        </div>

        <div class="footer-brand">
          <img
            src="https://www.kitclub.in/web/image/website/1/logo/KITCLUB?unique=7938d2f"
            alt="KITCLUB"
          />
          <p>Football jerseys, done right.</p>
          <a href="mailto:support@kitclub.in">support@kitclub.in</a>

          <div class="footer-socials">
            <a
              class="instagram"
              href="https://www.instagram.com/kitclub.in/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa fa-instagram" aria-hidden="true"></i>
            </a>
            <a
              class="whatsapp"
              href="https://chat.whatsapp.com/F7knZUObUaGFBvZosMC4Cu"
              aria-label="WhatsApp group"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa fa-whatsapp" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="footer-bottom-left">
          <p>© 2026 KITCLUB. All Rights Reserved</p>
          <div class="footer-legal-links">
            <a href="https://www.kitclub.in/">Cookie Policy</a>
            <span class="footer-legal-separator">•</span>
            <a href="https://www.kitclub.in/">Update Cookie Preferences</a>
          </div>
        </div>
      </div>


    </footer>

    <script>
      const siteHeader = document.querySelector(".site-header");
      let lastScrollY = window.scrollY;
      let scrollTicking = false;

      function updateHeaderOnScroll() {
        const currentScrollY = window.scrollY;

        if (!siteHeader || document.body.classList.contains("mobile-menu-open")) {
          lastScrollY = currentScrollY;
          scrollTicking = false;
          return;
        }

        if (currentScrollY <= 4) {
          siteHeader.classList.remove("header-hidden");
        } else if (currentScrollY > lastScrollY + 2) {
          siteHeader.classList.add("header-hidden");
        } else if (currentScrollY < lastScrollY - 1) {
          siteHeader.classList.remove("header-hidden");
        }

        lastScrollY = currentScrollY;
        scrollTicking = false;
      }

      window.addEventListener("scroll", () => {
        if (scrollTicking) return;
        scrollTicking = true;
        window.requestAnimationFrame(updateHeaderOnScroll);
      }, { passive: true });

      const searchModal = document.getElementById("site-search-modal");
      const searchTrigger = document.querySelector(".search-trigger");
      const searchInput = document.getElementById("site-search-input");
      const searchResults = searchModal?.querySelector(".search-results");
      const searchStatus = searchModal?.querySelector(".search-status");
      const searchCount = searchModal?.querySelector(".search-count-number");
      const searchCountLink = searchModal?.querySelector(".search-result-count");
      const accountWrap = document.querySelector(".account-wrap");
      const accountTrigger = document.querySelector(".account-menu-trigger");
      let searchTimer;
      let searchRequest = 0;

      function setSearchOpen(open) {
        if (!searchModal || !searchTrigger) return;
        searchModal.classList.toggle("is-open", open);
        searchModal.setAttribute("aria-hidden", String(!open));
        searchTrigger.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("search-open", open);
        if (open) {
          window.setTimeout(() => searchInput?.focus(), 40);
        } else {
          if (searchInput) searchInput.value = "";
          if (searchResults) searchResults.innerHTML = "";
          if (searchStatus) searchStatus.textContent = "";
          if (searchCount) searchCount.textContent = "";
          if (searchCountLink) searchCountLink.href = "https://www.kitclub.in/website/search/all";
        }
      }

      function escapeHtml(value) {
        const div = document.createElement("div");
        div.textContent = value ?? "";
        return div.innerHTML;
      }

      function absoluteUrl(value) {
        if (!value) return "https://www.kitclub.in/shop";
        if (value.startsWith("http://") || value.startsWith("https://")) return value;
        return `https://www.kitclub.in${value.startsWith("/") ? value : `/${value}`}`;
      }

      function getResultValue(item, keys) {
        for (const key of keys) {
          if (item && item[key] !== undefined && item[key] !== null && item[key] !== "") {
            return item[key];
          }
        }
        return "";
      }

      function renderSearchResults(data, term) {
        if (!searchResults || !searchStatus || !searchCount || !searchCountLink) return;

        searchResults.innerHTML = "";
        searchStatus.textContent = "";

        const results = Array.isArray(data?.results) ? data.results : [];
        const resultCount = Number(data?.results_count ?? results.length);

        if (!term) {
          searchCount.textContent = "";
          return;
        }

        searchCount.textContent = String(resultCount);
        searchCountLink.href = `https://www.kitclub.in/website/search/all?search=${encodeURIComponent(term)}`;

        if (!results.length) {
          searchStatus.textContent = "No results";
          return;
        }

        results.forEach((item) => {
          const name = getResultValue(item, ["name", "display_name", "title"]) || "Result";
          const url = absoluteUrl(getResultValue(item, ["website_url", "url", "href"]));
          const image = absoluteUrl(getResultValue(item, ["image_url", "image", "thumbnail"]));
          const description = getResultValue(item, ["description", "detail", "extra_detail"]);
          const detail = getResultValue(item, ["detail", "price", "website_price"]);
          const icon = getResultValue(item, ["_fa"]);

          const link = document.createElement("a");
          link.className = "search-result";
          link.href = url;

          let mediaHtml;
          if (image && !image.endsWith("/shop")) {
            mediaHtml = `<img src="${escapeHtml(image)}" alt="" loading="lazy">`;
          } else {
            mediaHtml = `<span class="search-result-icon"><i class="fa ${escapeHtml(icon || "fa-file-o")}" aria-hidden="true"></i></span>`;
          }

          const detailText = detail && detail !== name ? ` · ${detail}` : "";

          link.innerHTML = `
            ${mediaHtml}
            <span class="search-result-text">
              <strong>${name}${detailText}</strong>
              ${description ? `<span class="search-result-description">${description}</span>` : ""}
            </span>
          `;

          searchResults.appendChild(link);
        });
      }

      async function fetchSearchResults(term) {
        if (!term || !searchResults || !searchStatus) return;

        const requestId = ++searchRequest;
        searchStatus.textContent = "";

        try {
          const response = await fetch("https://www.kitclub.in/website/snippet/autocomplete", {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              jsonrpc: "2.0",
              method: "call",
              params: {
                search_type: "all",
                term,
                order: "name asc",
                limit: 20,
                max_nb_chars: 200,
                options: {
                  displayDescription: true,
                  displayDetail: true,
                  displayExtraDetail: true,
                  displayExtraLink: true,
                  displayImage: true,
                  allowFuzzy: true,
                },
              },
              id: Date.now(),
            }),
          });

          if (!response.ok) throw new Error("Search request failed");
          const payload = await response.json();
          if (requestId !== searchRequest) return;
          renderSearchResults(payload?.result, term);
        } catch (error) {
          if (requestId !== searchRequest) return;
          searchStatus.textContent = "";
          if (searchCount) searchCount.textContent = "";
          if (searchResults) {
            searchResults.innerHTML = `
              <a class="search-fallback" href="https://www.kitclub.in/website/search/all?search=${encodeURIComponent(term)}">
                Search KITCLUB for “${escapeHtml(term)}” →
              </a>
            `;
          }
        }
      }

      searchInput?.addEventListener("input", () => {
        const term = searchInput.value.trim();
        window.clearTimeout(searchTimer);
        searchRequest++;

        if (!term) {
          if (searchResults) searchResults.innerHTML = "";
          if (searchStatus) searchStatus.textContent = "";
          if (searchCount) searchCount.textContent = "";
          if (searchCountLink) searchCountLink.href = "https://www.kitclub.in/website/search/all";
          return;
        }

        searchTimer = window.setTimeout(() => fetchSearchResults(term), 120);
      });

      searchInput?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          const term = searchInput.value.trim();
          if (term) window.location.href = `https://www.kitclub.in/website/search/all?search=${encodeURIComponent(term)}`;
        }
      });

      const mobileMenu = document.getElementById("mobile-menu");
      const mobileMenuTrigger = document.querySelector(".mobile-menu-trigger");
      const mobileMenuSearchInput = document.getElementById("mobile-menu-search-input");
      const mobileMenuSearchButton = document.getElementById("mobile-menu-search-button");

      function setMobileMenuOpen(open) {
        if (!mobileMenu || !mobileMenuTrigger) return;
        mobileMenu.classList.toggle("is-open", open);
        mobileMenu.setAttribute("aria-hidden", String(!open));
        mobileMenuTrigger.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("mobile-menu-open", open);
        if (open) {
          window.setTimeout(() => mobileMenuSearchInput?.focus(), 80);
        }
      }

      mobileMenuTrigger?.addEventListener("click", () => setMobileMenuOpen(true));
      mobileMenu?.querySelectorAll("[data-mobile-menu-close]").forEach((element) => {
        element.addEventListener("click", () => setMobileMenuOpen(false));
      });

      mobileMenuSearchButton?.addEventListener("click", () => {
        const term = mobileMenuSearchInput?.value.trim();
        if (term) window.location.href = `https://www.kitclub.in/website/search/all?search=${encodeURIComponent(term)}`;
      });

      mobileMenuSearchInput?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          const term = mobileMenuSearchInput.value.trim();
          if (term) window.location.href = `https://www.kitclub.in/website/search/all?search=${encodeURIComponent(term)}`;
        }
      });

      searchTrigger?.addEventListener("click", () => setSearchOpen(true));
      searchModal?.querySelectorAll("[data-search-close]").forEach((element) => {
        element.addEventListener("click", () => setSearchOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setSearchOpen(false);
          setMobileMenuOpen(false);
          accountWrap?.classList.remove("is-open");
          accountTrigger?.setAttribute("aria-expanded", "false");
        }
      });

      accountTrigger?.addEventListener("click", (event) => {
        event.preventDefault();
        const open = !accountWrap?.classList.contains("is-open");
        accountWrap?.classList.toggle("is-open", open);
        accountTrigger.setAttribute("aria-expanded", String(open));
      });

      document.addEventListener("click", (event) => {
        if (accountWrap && !accountWrap.contains(event.target)) {
          accountWrap.classList.remove("is-open");
          accountTrigger?.setAttribute("aria-expanded", "false");
        }
      });

      fetch("https://www.kitclub.in/web/session/get_session_info", {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ jsonrpc: "2.0", method: "call", params: {}, id: Date.now() }),
      })
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          const session = payload?.result;
          document.body.classList.toggle("odoo-logged-in", Boolean(session?.uid));
        })
        .catch(() => {
          document.body.classList.remove("odoo-logged-in");
        });
    </script>
  </body>
</html>
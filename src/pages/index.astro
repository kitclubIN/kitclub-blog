---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="The KITCLUB Journal — football shirts, football culture, kit history and stories from the world of the beautiful game."
    />
    <title>KITCLUB Journal — Football Shirts &amp; Culture</title>
  </head>

  <body>
    <main>
      <section class="journal-hero">
        <div class="journal-hero-inner">
          <p class="journal-eyebrow">KITCLUB JOURNAL</p>
          <h1>Football shirts. Stories. Culture.</h1>
          <p class="journal-intro">
            A closer look at the kits, players, clubs and moments that make football
            more than just a game.
          </p>
        </div>
      </section>

      <section class="articles-section">
        <div class="articles-inner">
          <div class="section-heading">
            <h2>Latest from the Journal</h2>
          </div>

          {posts.length > 0 ? (
            <div class="article-grid">
              {posts.map((post) => (
                <article class="article-card">
                  <a
                    class="article-card-link"
                    href={`${import.meta.env.BASE_URL}journal/${post.id}/`}
                  >
                    {post.data.heroImage && (
                      <div class="article-image-wrap">
                        <Image
                          class="article-image"
                          src={post.data.heroImage}
                          alt={post.data.title}
                          loading="lazy"
                        />
                      </div>
                    )}

                    <div class="article-content">
                      <p class="article-date">
                        {post.data.pubDate.toLocaleDateString("en-IN", {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        })}
                      </p>

                      <h3>{post.data.title}</h3>

                      <p class="article-description">
                        {post.data.description}
                      </p>

                      <span class="read-more">Read article →</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <p>No articles yet.</p>
          )}
        </div>
      </section>
    </main>
  </body>
</html>

---
const articles = Object.entries(
  import.meta.glob("../content/blog/*.{md,mdx}", {
    eager: true,
  })
)
  .map(([path, module]: [string, any]) => ({
    slug: path.split("/").pop()?.replace(/\.(md|mdx)$/, ""),
    ...module.frontmatter,
  }))
  .filter((article) => article.title)
  .sort(
    (a, b) =>
      new Date(b.pubDate || 0).getTime() -
      new Date(a.pubDate || 0).getTime()
  );
---

<!doctype html>
<html lang="en-IN">
